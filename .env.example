# ── Copy to .env.local and fill in. Restart the API after edits ──
# (Node caches process.env at boot.)

# Browser-safe (VITE_ prefix → bundled into the client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: pick a tenant theme at build time (default | hospital | football | finance | maderunning)
VITE_TENANT=maderunning

# Optional, LOCAL ONLY. 1 = skip Supabase auth entirely: the app boots already
# signed in as Demo Admin (owner) and /login accepts any credentials. For
# showing the product without a reachable database.
#
# Never set this in the Vercel project. It is read at BUILD time, so a build
# made with it on stays bypassed wherever it is later deployed — the flag is
# baked into the bundle, not evaluated per request. While it is on, every
# screen carries an orange "Demo mode" pill so such a build is recognisable.
# VITE_DEMO_AUTH=1

# Server-only (NO VITE_ prefix → never reaches the browser)
ANTHROPIC_API_KEY=your-anthropic-key
VOYAGE_API_KEY=your-voyage-key

# ── Payments (Square) ─────────────────────────────────────────
# Get the access token from https://developer.squareup.com/apps →
# your app → Credentials. Set the SAME values in the Vercel project env.
# With no token set, /api/checkout answers { demo: true } and the booking
# and shop flows degrade gracefully (no card payment, no errors).
SQUARE_ACCESS_TOKEN=your-square-access-token
# Optional: skip the /v2/locations lookup. Find it under Square Dashboard →
# Account & Settings → Business → Locations.
SQUARE_LOCATION_ID=your-location-id
# 'production' (default) or 'sandbox'. These are different HOSTS on Square's
# side — a sandbox token against production fails loudly with a 401.
SQUARE_ENV=production

# Legacy fallback — only used if no Square token is configured.
STRIPE_SECRET_KEY=sk_your-stripe-key

# Ports. Use API_PORT (not PORT) — deploy tooling injects PORT for the web server.
API_PORT=8794
